  "text": {
    "en": {
      "name": "Dark Armed Dragon Punisher",
      "effect": "Cannot be Normal Summoned/Set. Must be Special Summoned (from your hand) by having exactly 3 DARK monsters in your GY. You can reveal this card in your hand; Special Summon 1 Level 6 or lower DARK monster from your hand, also you cannot Special Summon for the rest of this turn, except DARK monsters. During the Main Phase (Quick Effect): You can banish up to 3 DARK monsters from your GY, then target that many cards on the field; destroy them. You can only use each effect of \"Dark Armed Dragon Punisher\" once per turn.",
      "official": false
    },
    "ja": {
      "name": "\u30c0\u30fc\u30af\u30fb\u30a2\u30fc\u30e0\u30c9\u30fb\u30c9\u30e9\u30b4\u30f3\u30fb\u30d0\u30cb\u30c3\u30b7\u30e3\u30fc",
