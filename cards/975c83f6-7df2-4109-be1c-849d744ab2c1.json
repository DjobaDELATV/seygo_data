  "text": {
    "en": {
      "name": "Ars Magna DoomZ",
      "effect": "2 monsters, including an \"Ars Magna\" or \"DoomZ\" monster\nAny monster destroyed by battle with your linked monster is banished. You can only use each of the following effects of \"Ars Magna DoomZ\" once per turn. During your Main Phase: You can destroy, or banish, 1 card you control, then you can shuffle up to 2 cards from any GY(s) into the Deck. You can banish this card from your GY; Special Summon 1 \"DoomZ\" monster from your hand.",
      "official": false
    },
    "ja": {
      "name": "\u7121\u57a2\u306a\u308b\u8840\u76df \u30c9\u30a5\u30fc\u30e0\u30ba",
