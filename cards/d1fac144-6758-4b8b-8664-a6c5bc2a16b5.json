  "text": {
    "en": {
      "name": "The Twin Kings, Founders of the Empire",
      "effect": "Cannot be Special Summoned, except by Pendulum Summon. Requires 3 Beast-Type Tributes to Normal Summon (cannot be Normal Set). If this card attacks your opponent directly and reduces their LP to 0, while you control no other monsters, you win the Match.",
      "pendulumEffect": "Once per turn: You can banish 3 Beast-Type Pendulum Monsters you control, then target 1 Pendulum Monster you control; if it attacks your opponent directly and reduces their LP to 0 this turn, you win the Match."
    },
    "ja": {
      "name": "\u7259\u72fc\u306e\u53cc\u738b \u30ed\u30e0\u30eb\u30b9\uff0d\u30ec\u30e0\u30b9",
      "effect": "\u3053\u306e\u30ab\u30fc\u30c9\u306f\uff30\u53ec\u559a\u3067\u3057\u304b\u7279\u6b8a\u53ec\u559a\u3067\u304d\u306a\u3044\u3002\u3053\u306e\u30ab\u30fc\u30c9\u3092\u901a\u5e38\u53ec\u559a\u3059\u308b\u5834\u5408\u3001\u7363\u65cf\u30e2\u30f3\u30b9\u30bf\u30fc\uff13\u4f53\u3092\u30ea\u30ea\u30fc\u30b9\u3057\u3066\u53ec\u559a\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3002\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u3053\u306e\u30ab\u30fc\u30c9\u4ee5\u5916\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u5b58\u5728\u305b\u305a\u3001\u3053\u306e\u30ab\u30fc\u30c9\u304c\u76f4\u63a5\u653b\u6483\u3067\u76f8\u624b\u306e\uff2c\uff30\u3092\uff10\u306b\u3057\u305f\u5834\u5408\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306f\u30de\u30c3\u30c1\u306b\u52dd\u5229\u3059\u308b\u3002",
      "pendulumEffect": "\u2460\uff1a\uff11\u30bf\u30fc\u30f3\u306b\uff11\u5ea6\u3001\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u7363\u65cf\uff30\u30e2\u30f3\u30b9\u30bf\u30fc\uff13\u4f53\u3092\u9664\u5916\u3057\u3001\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\uff30\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u5bfe\u8c61\u3068\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u76f4\u63a5\u653b\u6483\u3067\u76f8\u624b\u306e\uff2c\uff30\u3092\uff10\u306b\u3057\u305f\u5834\u5408\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306f\u30de\u30c3\u30c1\u306b\u52dd\u5229\u3059\u308b\u3002"
    },
    "ko": {
      "name": "\uc544\ub791\uc758 \uc30d\uc655 \ub85c\ubb3c\ub8e8\uc2a4-\ub808\ubb34\uc2a4",
      "effect": "\uc774 \uce74\ub4dc\ub97c \ud1b5\uc0c1 \uc18c\ud658\ud560 \uacbd\uc6b0, \uc57c\uc218\uc871 \ubaac\uc2a4\ud130 3\uc7a5\uc744 \ub9b4\ub9ac\uc2a4\ud558\uace0 \uc77c\ubc18 \uc18c\ud658\ud574\uc57c \ud55c\ub2e4. \uc774 \uce74\ub4dc\ub294 \ud39c\ub4c8\ub7fc \uc18c\ud658\uc73c\ub85c\ubc16\uc5d0 \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc5c6\ub2e4. \uc790\uc2e0\uc758 \ud544\ub4dc\uc5d0 \uc774 \uce74\ub4dc \uc774\uc678\uc758 \ubaac\uc2a4\ud130\uac00 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc73c\uba70, \uc774 \uce74\ub4dc\uac00 \uc9c1\uc811 \uacf5\uaca9\uc73c\ub85c \uc0c1\ub300\uc758 LP\ub97c 0 \uc73c\ub85c \ud560 \uacbd\uc6b0, \uc774 \uce74\ub4dc\uc758 \ucee8\ud2b8\ub864\ub7ec\ub294 \ub9e4\uce58\uc5d0 \uc2b9\ub9ac\ud55c\ub2e4.",
      "pendulumEffect": "\u2460 : 1\ud134\uc5d0 1\ubc88, \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc\uc758 \uc57c\uc218\uc871 \ud39c\ub4c8\ub7fc \ubaac\uc2a4\ud130 3\uc7a5\uc744 \uc81c\uc678\ud558\uace0, \uc790\uc2e0\uc758 \ud544\ub4dc\uc758 \ud39c\ub4c8\ub7fc \ubaac\uc2a4\ud130 1\uc7a5\uc744 \ub300\uc0c1\uc73c\ub85c \ud558\uc5ec \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4. \uc774 \ud134\uc5d0 \uadf8 \ubaac\uc2a4\ud130\uac00 \uc9c1\uc811 \uacf5\uaca9\uc73c\ub85c \uc0c1\ub300\uc758 LP\ub97c 0 \uc73c\ub85c \ud588\uc744 \uacbd\uc6b0, \uc790\uc2e0\uc740 \ub9e4\uce58\uc5d0\uc11c \uc2b9\ub9ac\ud55c\ub2e4."
    },
    "zh-CN": {
      "name": "\u7259\u72fc\u4e4b\u53cc\u738b \u7f57\u6155\u8def\u65af\uff0d\u96f7\u7a46\u65af",
      "effect": "\u8981\u901a\u5e38\u53ec\u5524\u6b64\u5361\u7684\u60c5\u51b5\u4e0b\uff0c\u5fc5\u987b\u89e3\u653e3\u53ea\u517d\u65cf\u602a\u517d\u6765\u53ec\u5524\u3002\u6b64\u5361\u4ec5\u53ef\u4ee5\u7075\u6446\u53ec\u5524\u65b9\u5f0f\u7279\u6b8a\u53ec\u5524\u3002\u81ea\u5df1\u573a\u4e0a\u4e0d\u5b58\u5728\u5176\u4ed6\u602a\u517d\uff0c\u6b64\u5361\u4ee5\u76f4\u63a5\u653b\u51fb\u4f7f\u5bf9\u624b\u7684LP\u5f52\u96f6\u7684\u60c5\u51b5\u4e0b\uff0c\u6b64\u5361\u7684\u63a7\u5236\u8005\u83b7\u5f97\u6bd4\u8d5b\u80dc\u5229\u3002",
      "pendulumEffect": "\u2460\uff1a1\u56de\u54081\u6b21\uff0c\u5c06\u81ea\u5df1\u573a\u4e0a\u76843\u53ea\u8868\u4fa7\u8868\u793a\u7684\u517d\u65cf\u7075\u6446\u602a\u517d\u9664\u5916\uff0c\u4ee5\u81ea\u5df1\u573a\u4e0a\u76841\u53ea\u7075\u6446\u602a\u517d\u4e3a\u5bf9\u8c61\u53ef\u4ee5\u53d1\u52a8\u3002\u6b64\u56de\u5408\uff0c\u8be5\u602a\u517d\u4ee5\u76f4\u63a5\u653b\u51fb\u4f7f\u5bf9\u624b\u7684LP\u5f52\u96f6\u7684\u60c5\u51b5\u4e0b\uff0c\u81ea\u5df1\u83b7\u5f97\u6bd4\u8d5b\u80dc\u5229\u3002"
    }
