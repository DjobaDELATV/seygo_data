  "text": {
    "en": {
      "name": "Black Potan",
      "effect": "If you control a face-up Tuner monster, this card cannot be destroyed by battle. When a face-up Tuner monster(s) you control is removed from the field, gain 800 Life Points."
    },
    "fr": {
      "name": "Potan Sombre",
