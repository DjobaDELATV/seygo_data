  "text": {
    "en": {
      "name": "Phantom Hand",
      "effect": "Once per turn, if you control a face-up \"Infernity\" monster(s), you can remove from play all cards in your hand (face-down) until your next Standby Phase."
    },
    "fr": {
      "name": "Main Fant\u00f4me",
      "effect": "Une fois par tour, si vous contr\u00f4lez un monstre \"Enfernit\u00e9\" face recto, vous pouvez retirer du jeu toutes les cartes dans votre main (face verso) jusqu'\u00e0 votre prochaine Standby Phase."
    },
    "de": {
      "name": "Phantomhand",
      "effect": "Einmal pro Spielzug, falls du offene \u201eEwig infernal\u201c-Monster kontrollierst, kannst du alle Karten in deiner Hand bis zu deiner n\u00e4chsten Standby Phase verdeckt aus dem Spiel entfernen."
    },
    "it": {
