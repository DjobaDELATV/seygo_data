  "text": {
    "en": {
      "name": "Splendid Venus",
      "effect": "All non-Fairy monsters lose 500 ATK/DEF. The activation and effects of Spell/Trap Cards activated on your field cannot be negated."
    },
    "fr": {
      "name": "V\u00e9nus Splendide",
      "effect": "Tous les monstres non-Elfe perdent 500 ATK/DEF. L'activation et les effets de Cartes Magie/Pi\u00e8ge activ\u00e9s sur votre Terrain ne peuvent pas \u00eatre annul\u00e9s."
    },
    "de": {
      "name": "Famose Venus",
      "effect": "Alle Nicht-Fee-Monster verlieren 500 ATK/DEF. Die Aktivierung und die Effekte von Zauber-/Fallenkarten, die auf deiner Spielfeldseite aktiviert werden, k\u00f6nnen nicht annulliert werden."
    },
    "it": {
      "name": "Venere Splendida",
      "effect": "Tutti i mostri non-Fata perdono 500 ATK/DEF. L'attivazione e gli effetti delle Carte Magia/Trappola attivate sul tuo Terreno non possono essere annullate."
    },
    "pt": {
      "name": "V\u00eanus Espl\u00eandida",
      "effect": "Todos os monstros n\u00e3o-Fada perdem 500 de ATK/DEF. A ativa\u00e7\u00e3o e os efeitos de Cards de Magia/Armadilha ativados no seu campo n\u00e3o podem ser negados."
    },
    "es": {
      "name": "Venus Espl\u00e9ndida",
      "effect": "Todos los monstruos que no sean Hada pierden 500 ATK/DEF. La activaci\u00f3n y los efectos de Cartas M\u00e1gicas/de Trampa activadas en tu Campo no pueden ser negados."
    },
    "ja": {
      "name": "\uff34\uff48\uff45 \uff53\uff50\uff4c\uff45\uff4e\uff44\uff49\uff44 \uff36\uff25\uff2e\uff35\uff33",
