    },
    "ko": {
      "name": "The splendid VENUS",
      "effect": "\u2460 : \uc774 \uce74\ub4dc\uac00 \ubaac\uc2a4\ud130 \uc874\uc5d0 \uc874\uc7ac\ud558\ub294 \ud55c, \ucc9c\uc0ac\uc871 \uc774\uc678\uc758 \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130\uc758 \uacf5\uaca9\ub825 / \uc218\ube44\ub825\uc740 500 \ub0b4\ub9ac\uace0, \uc790\uc2e0 \ud544\ub4dc\uc758 \ub9c8\ubc95 / \ud568\uc815 \uce74\ub4dc\uc758 \ud6a8\uacfc \ubc1c\ub3d9 \ubc0f \uadf8 \ubc1c\ub3d9\ud55c \ud6a8\uacfc\ub294 \ubb34\ud6a8\ud654\ub418\uc9c0 \uc54a\ub294\ub2e4."
    }
