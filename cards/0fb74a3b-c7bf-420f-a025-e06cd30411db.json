{
  "$schema": "https://raw.githubusercontent.com/DjobaDELATV/seygo_data/main/schema/v1/card.json",
  "id": "0fb74a3b-c7bf-420f-a025-e06cd30411db",
  "text": {
    "en": {
      "name": "Wrath of Neos",
      "effect": "Target 1 \"Elemental HERO Neos\" in your Monster Zone; shuffle that \"Elemental HERO Neos\" into the Deck, and if you do, destroy all cards on the field."
    },
    "fr": {
      "name": "Col\u00e8re de N\u00e9os",
      "effect": "Ciblez 1 \"N\u00e9os, H\u00c9ROS \u00c9l\u00e9mentaire\" dans votre Zone Monstre ; m\u00e9langez ce \"N\u00e9os, H\u00c9ROS \u00c9l\u00e9mentaire\" dans le Deck, et si vous le faites, d\u00e9truisez toutes les cartes sur le Terrain."
    },
    "de": {
      "name": "Neos' Zorn",
      "effect": "W\u00e4hle 1 \u201eElementar-HELD Neos\u201c in deiner Monsterzone; mische den \u201eElementar-HELD Neos\u201c ins Deck und falls du dies tust, zerst\u00f6re alle Karten auf dem Spielfeld."
    },
    "it": {
      "name": "Ira di Neos",
      "effect": "Scegli come bersaglio 1 \"Neos EROE Elementale\" nella tua Zona Mostri; mischia quel \"Neos EROE Elementale\" nel Deck e, se lo fai, distruggi tutte le carte sul Terreno."
    },
    "pt": {
      "name": "Ira de Neos",
      "effect": "Escolha 1 \"Neos, o HER\u00d3I do Elemento\" na sua Zona de Monstros; embaralhe esse \"Neos, o HER\u00d3I do Elemento\" no Deck e, se isso acontecer, destrua todos os cards no campo."
    },
    "es": {
      "name": "La Furia de Neos",
      "effect": "Selecciona 1 \"H\u00c9ROE Elemental Neos\" en tu Zona de Monstruos; baraja al Deck ese \"H\u00c9ROE Elemental Neos\" y, si lo haces, destruye todas las cartas en el Campo."
    },
    "ja": {
