  "text": {
    "en": {
      "name": "Ars Magna of Infinity and Finity",
      "effect": "You can banish this card from your hand; add 1 non-Warrior \"Ars Magna\" monster from your Deck to your hand, also the original ATK of \"Power Patron\" Link Monsters you control become tripled for the rest of this turn. If a Fusion and/or Link Monster(s) is Special Summoned while this card is banished (except during the Damage Step): You can Special Summon this card. If you control a \"Power Patron\" Link Monster: You can target 1 monster on the field; banish it. You can only use each effect of \"Ars Magna of Infinity and Finity\" once per turn.",
      "official": false
    },
    "ja": {
