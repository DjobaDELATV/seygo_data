  "text": {
    "en": {
      "name": "Reload",
      "effect": "Add all cards in your hand to your Deck and shuffle it. Then draw the same number of cards that you added to your Deck."
    },
    "fr": {
      "name": "Recharge",
      "effect": "Ajoutez votre main au Deck et m\u00e9langez-le. Piochez ensuite le m\u00eame nombre de cartes que vous avez ajout\u00e9 au Deck."
    },
    "de": {
      "name": "Nachladen",
      "effect": "F\u00fcge deine Hand zu deinem Deck hinzu und mische es. Dann ziehe dieselbe Anzahl Karten, die du deinem Deck hinzugef\u00fcgt hattest."
    },
    "it": {
      "name": "Ricarica",
      "effect": "Aggiungi tutte le carte nella tua mano al Deck e mescolalo. Quindi pesca lo stesso numero di carte che hai aggiunto al Deck."
    },
    "pt": {
      "name": "Recarregar",
      "effect": "Adicione a sua m\u00e3o ao seu Deck e embaralhe-o. Em seguida, compre o mesmo n\u00famero de cards que adicionou ao seu Deck."
    },
    "es": {
      "name": "Recarga",
      "effect": "A\u00f1ade tu mano a tu Deck y bar\u00e1jalo. Entonces roba el mismo n\u00famero de cartas que a\u00f1adiste a tu Deck."
    },
    "ja": {
      "name": "\u30ea\u30ed\u30fc\u30c9",
      "effect": "\u81ea\u5206\u306e\u624b\u672d\u3092\u5168\u3066\u30c7\u30c3\u30ad\u306b\u52a0\u3048\u3066\u30b7\u30e3\u30c3\u30d5\u30eb\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u30c7\u30c3\u30ad\u306b\u52a0\u3048\u305f\u679a\u6570\u5206\u306e\u30ab\u30fc\u30c9\u3092\u30c9\u30ed\u30fc\u3059\u308b\u3002"
    },
    "ko": {
