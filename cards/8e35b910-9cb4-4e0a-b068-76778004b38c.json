  "id": "8e35b910-9cb4-4e0a-b068-76778004b38c",
  "text": {
    "en": {
      "name": "Queen's Pawn",
      "effect": "When an \"Amazoness\" monster you control destroys an opponent's monster by battle and sends it to the GY: Special Summon 1 Level 4 or lower \"Amazoness\" monster from your Deck."
    },
    "fr": {
      "name": "Pion de la Reine",
      "effect": "Lorsqu'un monstre \"Amazonesse\" que vous contr\u00f4lez d\u00e9truit un monstre de l'adversaire au combat et l'envoie au Cimeti\u00e8re : Invoquez Sp\u00e9cialement 1 monstre \"Amazonesse\" de max. Niveau 4 depuis votre Deck."
    },
    "de": {
      "name": "Schergin der K\u00f6nigin",
      "effect": "Wenn ein \u201eAmazonisch\u201c-Monster, das du kontrollierst, ein Monster eines Gegners durch Kampf zerst\u00f6rt und auf den Friedhof legt: Beschw\u00f6re 1 \u201eAmazonisch\u201c-Monster der Stufe 4 oder niedriger als Spezialbeschw\u00f6rung von deinem Deck."
    },
    "it": {
      "name": "Pedina della Regina",
      "effect": "Quando un mostro \"Amazoness\" che controlli distrugge un mostro dell'avversario in battaglia e lo manda al Cimitero: Evoca Specialmente 1 mostro \"Amazoness\" di Livello 4 o inferiore dal tuo Deck."
    },
    "pt": {
      "name": "Sele\u00e7\u00e3o da Rainha",
      "effect": "Quando um monstro \"Amazoness\" que voc\u00ea controla destruir um monstro do oponente em batalha e envi\u00e1-lo para o Cemit\u00e9rio: Invoque por Invoca\u00e7\u00e3o-Especial 1 monstro \"Amazoness\" de N\u00edvel 4 ou menos do seu Deck."
    },
    "es": {
      "name": "Pe\u00f3n de la Reina",
      "effect": "Cuando un monstruo \"Amazoness\" que controlas destruye un monstruo del adversario en batalla y lo manda al Cementerio: Invoca de Modo Especial, desde tu Deck, 1 monstruo \"Amazoness\" de Nivel 4 o menor."
    },
