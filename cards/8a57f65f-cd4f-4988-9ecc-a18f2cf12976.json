  "text": {
    "en": {
      "name": "Swiftwind Panther Warrior",
      "effect": "During the Main Phase (Quick Effect): You can Tribute 1 other monster from your hand or field, then activate 1 of these effects;\n\u25cf Special Summon 1 monster that mentions \"Dark Time Wizard\" from your hand or Deck, except \"Swiftwind Panther Warrior\".\n\u25cf Send 1 Spell/Trap that mentions \"Dark Time Wizard\" from your Deck to the GY.\nYou can only use this effect of \"Swiftwind Panther Warrior\" once per turn. Cannot declare an attack unless a monster(s) was Tributed this turn.",
      "official": false
    },
    "ja": {
      "name": "\u75be\u98a8\u306e\u8c79\u6226\u58eb\u30d1\u30f3\u30b5\u30fc\u30a6\u30a9\u30ea\u30a2\u30fc",
