  "text": {
    "en": {
      "name": "The Flute of Summoning Kuriboh",
      "effect": "Take 1 \"Kuriboh\" or 1 \"Winged Kuriboh\" from your Deck, and either add it to your hand or Special Summon it."
    },
    "fr": {
      "name": "Fl\u00fbte d'Invocation Kuriboh",
      "effect": "Prenez 1 \"Kuriboh\" ou 1 \"Kuriboh Ail\u00e9\" depuis votre Deck, et soit ajoutez-le \u00e0 votre main soit Invoquez-le Sp\u00e9cialement."
    },
    "de": {
      "name": "Die Fl\u00f6te der Kuriboh-Beschw\u00f6rung",
