  "text": {
    "en": {
      "name": "Sun God Domination",
      "effect": "If a \"The Winged Dragon of Ra\" monster is on the field: Apply these effects in sequence.\n\u25cf Special Summon 1 monster from each GY to your field.\n\u25cf If \"The Winged Dragon of Ra\" is on the field, take control of all monsters your opponent controls.\nYou can banish this card from your GY and Tribute 1 \"The Winged Dragon of Ra\" monster; gain LP equal to the ATK it had on the field. You can only use each effect of \"Sun God Domination\" once per turn.",
      "official": false
    },
    "ja": {
