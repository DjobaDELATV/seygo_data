  "text": {
    "en": {
      "name": "Supremacy Berry",
      "effect": "If your Life Points were lower than your opponent's when this card was activated, gain 2000 Life Points. If your Life Points were higher than your opponent's, you take 1000 damage."
    },
    "fr": {
      "name": "Fruit Supr\u00eame",
