    },
    "ko": {
      "name": "\uc790\uc774\uc5b8\ud2b8 \ub809\uc2a4",
      "effect": "\uc774 \uce74\ub4dc\uba85\uc758 \u2461\uc758 \ud6a8\uacfc\ub294 1\ud134\uc5d0 1\ubc88\ubc16\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4. \u2460: \uc774 \uce74\ub4dc\ub294 \uc9c1\uc811 \uacf5\uaca9\ud560 \uc218 \uc5c6\ub2e4. \u2461: \uc774 \uce74\ub4dc\uac00 \uc81c\uc678\ub418\uc5c8\uc744 \uacbd\uc6b0\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4. \uc774 \uce74\ub4dc\ub97c \ud2b9\uc218 \uc18c\ud658\ud55c\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c \uc774 \uce74\ub4dc\uc758 \uacf5\uaca9\ub825\uc740, \uc81c\uc678\ub418\uc5b4 \uc788\ub294 \uc790\uc2e0\uc758 \uacf5\ub8e1\uc871 \ubaac\uc2a4\ud130\uc758 \uc218 \u00d7 200 \uc62c\ub9b0\ub2e4."
    },
    "zh-CN": {
