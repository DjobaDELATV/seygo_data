      "pendulumEffect": "\u2460\uff1a\u602a\u517d\u88ab\u4ece\u989d\u5916\u724c\u7ec4\u7279\u6b8a\u53ec\u5524\u7684\u60c5\u51b5\u4e0b\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u6b64\u5361\u653e\u56de\u989d\u5916\u724c\u7ec4\u3002\u7136\u540e\uff0c\u53ef\u5c06\u5305\u542b\u81ea\u5df1\u573a\u4e0a\u7684\u201c\u72f1\u795e\u201d\u602a\u517d\u5728\u5185\u7684\u3001\u81ea\u5df1\u30fb\u5bf9\u624b\u573a\u4e0a\u7684\u602a\u517d\u4f5c\u4e3a\u878d\u5408\u7d20\u6750\uff0c\u5c061\u53ea\u878d\u5408\u602a\u517d\u878d\u5408\u53ec\u5524\u3002"
