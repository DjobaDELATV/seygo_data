  "text": {
    "en": {
      "name": "King of Beasts, Risen from the Valley of Flames",
      "effect": "3 FIRE Effect Monsters\n(This card is always treated as \"Salamangreat Heatleo\".)\nFace-up monsters on the field become FIRE. During the Main Phase, if this card was Link Summoned using \"Salamangreat Heatleo\" (Quick Effect): You can target 1 card your opponent controls; shuffle it into the Deck, then you can make the ATK of 1 FIRE monster your opponent controls become the ATK of 1 monster in your GY. You can only use this effect of \"King of Beasts, Risen from the Valley of Flames\" once per turn.",
      "official": false
    },
    "ja": {
      "name": "\u708e\u306e\u5e73\u539f\u3092\u99c6\u3051\u629c\u3051\u308b\u767e\u7363\u306e\u738b",
