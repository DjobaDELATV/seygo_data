    "zh-CN": {
      "name": "\u9a70\u9a8b\u6a2a\u8d8a\u708e\u4e4b\u5e73\u539f\u7684\u767e\u517d\u4e4b\u738b",
      "effect": "\u708e\u5c5e\u6027\u7684\u6548\u679c\u602a\u517d3\u53ea\n\u6b64\u5361\u540d\u5728\u89c4\u5219\u4e0a\u89c6\u4e3a\u201c\u8f6c\u751f\u708e\u517d \u70bd\u70ed\u731b\u72ee\u201d\u3002\u6b64\u5361\u540d\u7684\u2461\u6548\u679c1\u56de\u5408\u4ec5\u53ef\u4f7f\u75281\u6b21\u3002\u2460\uff1a\u573a\u4e0a\u7684\u8868\u4fa7\u8868\u793a\u602a\u517d\u53d8\u4e3a\u708e\u5c5e\u6027\u3002\u2461\uff1a\u6b64\u5361\u662f\u4ee5\u201c\u8f6c\u751f\u708e\u517d \u70bd\u70ed\u731b\u72ee\u201d\u4f5c\u4e3a\u7d20\u6750\u88ab\u8fde\u63a5\u53ec\u5524\u7684\u60c5\u51b5\u4e0b\uff0c\u5728\u81ea\u5df1\u30fb\u5bf9\u624b\u7684\u4e3b\u8981\u9636\u6bb5\uff0c\u4ee5\u5bf9\u624b\u573a\u4e0a\u76841\u5f20\u5361\u4e3a\u5bf9\u8c61\u53ef\u4ee5\u53d1\u52a8\u3002\u5c06\u8be5\u5361\u653e\u56de\u724c\u7ec4\u3002\u7136\u540e\uff0c\u53ef\u5c06\u5bf9\u624b\u573a\u4e0a\u76841\u53ea\u708e\u5c5e\u6027\u602a\u517d\u7684\u653b\u51fb\u529b\u6539\u6210\u4e0e\u81ea\u5df1\u5893\u5730\u76841\u53ea\u602a\u517d\u7684\u653b\u51fb\u529b\u76f8\u540c\u3002"
