  "text": {
    "en": {
      "name": "Destruction of Destiny",
      "effect": "Send 3 cards from the top of your Deck to the Graveyard, and take 1000 damage for each Spell or Trap Card sent to the Graveyard this way."
    },
    "fr": {
      "name": "Destruction de la Destin\u00e9e",
      "effect": "Envoyez 3 cartes du dessus de votre Deck au Cimeti\u00e8re et recevez 1000 points de dommages pour chaque Carte Magie ou Pi\u00e8ge envoy\u00e9e au Cimeti\u00e8re de cette mani\u00e8re."
    },
    "de": {
      "name": "Zerst\u00f6rung des Schicksals",
      "effect": "Lege die 3 obersten Karten von deinem Deck auf den Friedhof. Du erh\u00e4ltst 1000 Punkte Schaden f\u00fcr jede Zauber- oder Fallenkarte, die durch diesen Effekt auf den Friedhof gelegt wurde."
    },
    "it": {
