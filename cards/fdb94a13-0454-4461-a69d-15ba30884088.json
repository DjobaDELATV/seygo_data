  "text": {
    "en": {
      "name": "Monstrous Arms of Atlantis",
      "effect": "This card's name becomes \"Umi\" while in the Monster Zone. You can only use each of the following effects of \"Monstrous Arms of Atlantis\" once per turn. If this card is Normal or Special Summoned: You can target 1 monster in your GY that mentions \"Atlantis, City of the Sea Dragon\"; Special Summon it in Defense Position. When your opponent activates a monster effect (Quick Effect): You can banish this card from your field or GY and send 1 face-up \"Umi\" you control to the GY; negate that effect.",
      "official": false
    },
    "ja": {
