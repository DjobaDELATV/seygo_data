  "text": {
    "en": {
      "name": "Metamorphosis",
      "effect": "Tribute 1 monster; Special Summon 1 Fusion Monster from your Extra Deck with the same Level as the Tributed monster."
    },
    "fr": {
      "name": "M\u00e9tamorphose",
      "effect": "Sacrifiez 1 monstre ; Invoquez Sp\u00e9cialement 1 Monstre Fusion depuis votre Extra Deck du m\u00eame Niveau que le monstre Sacrifi\u00e9."
    },
    "de": {
      "name": "Metamorphose",
      "effect": "Biete 1 Monster als Tribut an; beschw\u00f6re 1 Fusionsmonster mit derselben Stufe wie das als Tribut angebotene Monster als Spezialbeschw\u00f6rung von deinem Extra Deck."
    },
