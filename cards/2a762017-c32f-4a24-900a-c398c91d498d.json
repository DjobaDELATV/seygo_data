  "text": {
    "en": {
      "name": "Reindsurm Carnation",
      "effect": "While you control a \"Reindsurm\" monster whose original Level is 8 or higher or your opponent has a Dragon monster in their field or GY, the activated effects of your \"Reindsurm\" monsters cannot be negated. Once per turn: You can send 1 \"Reindsurm\" monster or Dragon monster from your hand or face-up field to the GY; add 1 Insect monster from your Deck to your hand with the same original Level, but a different original name.",
      "official": false
    },
