  "text": {
    "en": {
      "name": "Witchcrafter Seed",
      "effect": "If this card is Normal or Special Summoned, and you control \"Regulus, the Prince of Endymion\" or a \"Witchcrafter\" monster, except \"Witchcrafter Seed\": You can target 1 face-up card on the field; return it to the hand. You can banish this card from your GY; reveal any number of cards in your hand, including a Spell, shuffle them into the Deck, then draw cards equal to the number shuffled. You can only use each effect of \"Witchcrafter Seed\" once per turn."
    },
    "ja": {
      "name": "\u30a6\u30a3\u30c3\u30c1\u30af\u30e9\u30d5\u30c8\u30fb\u30b7\u30fc\u30c9",
