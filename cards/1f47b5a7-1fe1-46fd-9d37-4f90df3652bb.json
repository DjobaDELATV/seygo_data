    "zh-CN": {
      "name": "\u767d\u9e26\u4e4b\u68ee\u7684\u5973\u4e3b\u4eba \u8fea\u4e9a\u8d1d\u5c14\u8d5b",
      "effect": "\u878d\u5408\u30fb\u540c\u6b65\u602a\u517d\uff0b\u9b54\u6cd5\u5e08\u65cf\u30fb\u5e7b\u60f3\u9b54\u65cf\u602a\u517d\n\u6b64\u5361\u540d\u7684\u2460\u6548\u679c1\u56de\u5408\u4ec5\u53ef\u4f7f\u75281\u6b21\u3002\u2460\uff1a\u6b64\u5361\u7279\u6b8a\u53ec\u5524\u7684\u60c5\u51b5\u4e0b\u53ef\u4ee5\u53d1\u52a8\u3002\u6311\u9009\u81ea\u5df1\u573a\u4e0a\u4efb\u610f\u6570\u91cf\u7684\u602a\u517d\uff0c\u89c6\u4e3a\u6c38\u7eed\u9b54\u6cd5\u5361\u4ee5\u8868\u4fa7\u8868\u793a\u653e\u5728\u539f\u672c\u6301\u6709\u8005\u7684\u9b54\u6cd5\u4e0e\u9677\u9631\u533a\u57df\u3002\u7136\u540e\uff0c\u53ef\u6700\u591a\u4f9d\u81ea\u5df1\u573a\u4e0a\u7684\u9b54\u6cd5\u30fb\u9677\u9631\u5361\u7684\u6570\u91cf\u5c06\u573a\u4e0a\u7684\u5361\u653e\u56de\u624b\u724c\u3002\u2461\uff1a\u6b64\u5361\u7684\u653b\u51fb\u529b\u30fb\u5b88\u5907\u529b\u4e0a\u5347\u573a\u4e0a\u7684\u9b54\u6cd5\u30fb\u9677\u9631\u5361\u7684\u6570\u91cf\u00d7700\u7684\u6570\u503c\u3002\u2462\uff1a\u878d\u5408\u53ec\u5524\u7684\u8868\u4fa7\u8868\u793a\u7684\u6b64\u5361\u4e0d\u53ef\u4f5c\u4e3a\u878d\u5408\u7d20\u6750\u3002"
