  "text": {
    "en": {
      "name": "Gravekeeper's Recruiter",
      "effect": "If this card you control is sent to your GY: Add 1 \"Gravekeeper's\" monster with 1500 or less DEF from your Deck to your hand."
    },
    "fr": {
      "name": "Recruteur des Protecteurs du Tombeau",
      "effect": "Si cette carte que vous contr\u00f4lez est envoy\u00e9e \u00e0 votre Cimeti\u00e8re : ajoutez 1 monstre \"Protecteurs du Tombeau\" avec max. 1500 DEF depuis votre Deck \u00e0 votre main."
    },
    "de": {
      "name": "Grabw\u00e4chters Anwerber",
