  "text": {
    "en": {
      "name": "Storm",
      "effect": "Destroy as many Spells/Traps you control as possible, then destroy as many Spells/Traps your opponent controls as possible, up to the number of cards destroyed by this effect."
    },
    "fr": {
      "name": "Temp\u00eate",
      "effect": "D\u00e9truisez autant de Magies/Pi\u00e8ges que vous contr\u00f4lez que possible, puis d\u00e9truisez un nombre de Magies/Pi\u00e8ges contr\u00f4l\u00e9s par votre adversaire inf\u00e9rieur ou \u00e9gal au nombre de cartes d\u00e9truites par cet effet."
    },
    "de": {
      "name": "Sturm",
      "effect": "Zerst\u00f6re so viele Zauber/Fallen, die du kontrollierst, wie m\u00f6glich, dann zerst\u00f6re so viele Zauber/Fallen, die dein Gegner kontrolliert, wie m\u00f6glich, bis zur Anzahl der durch diesen Effekt zerst\u00f6rten Karten."
    },
    "it": {
      "name": "Tempesta",
      "effect": "Distruggi tante Magie/Trappole che controlli quante possibile, poi distruggi tante Magie/Trappole controllate dal tuo avversario quante possibile, fino al numero di carte distrutte da questo effetto."
    },
    "pt": {
      "name": "Tempestade",
      "effect": "Destrua tantos Cards de Magia/Armadilha que voc\u00ea controla quanto poss\u00edvel e, depois, destrua tantos Cards de Magia/Armadilha que seu oponente controla quanto poss\u00edvel, at\u00e9 o n\u00famero de cards destru\u00eddo por este efeito."
    },
    "es": {
      "name": "Tormenta",
      "effect": "Destruye tantas M\u00e1gicas/Trampas que controles como sea posible, y despu\u00e9s destruye tantas M\u00e1gicas/Trampas que controle tu adversario como sea posible, hasta la cantidad de cartas destruidas por este efecto."
    },
