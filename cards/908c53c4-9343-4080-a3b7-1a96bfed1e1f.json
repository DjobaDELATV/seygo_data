  "text": {
    "en": {
      "name": "Risebell the Star Adjuster",
      "effect": "When this card is Special Summoned: You can target 1 face-up monster on the field; increase its Level by up to 3 until the end of this turn."
    },
    "fr": {
      "name": "Risebell l'Expert en \u00c9toiles",
      "effect": "Lorsque cette carte est Invoqu\u00e9e Sp\u00e9cialement : vous pouvez cibler 1 monstre face recto sur le Terrain ; jusqu'\u00e0 la fin de ce tour, augmentez son Niveau de max. 3."
    },
    "de": {
      "name": "Risebell der Sternjustierer",
      "effect": "Wenn diese Karte als Spezialbeschw\u00f6rung beschworen wird: Du kannst 1 offenes Monster auf dem Spielfeld w\u00e4hlen; erh\u00f6he seine Stufe bis zum Ende dieses Spielzugs um bis zu 3."
    },
    "it": {
      "name": "Risebell il Modificatore di Stelle",
      "effect": "Quando questa carta viene Evocata Specialmente: puoi scegliere come bersaglio 1 mostro scoperto sul Terreno; aumenta il suo Livello di fino a 3 fino alla fine di questo turno."
    },
    "pt": {
      "name": "Risebell, o Ajustador de Estrelas",
      "effect": "Quando este card for Invocado por Invoca\u00e7\u00e3o-Especial: voc\u00ea pode escolher 1 monstro com a face para cima no campo; aumente o N\u00edvel dele em at\u00e9 3 at\u00e9 o final deste turno."
    },
    "es": {
      "name": "Risebell el Ajustador de Estrellas",
      "effect": "Cuando esta carta es Invocada de Modo Especial: puedes seleccionar 1 monstruo boca arriba en el Campo; hasta el final de este turno, aumenta su Nivel hasta en 3."
    },
