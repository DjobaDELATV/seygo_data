  "text": {
    "en": {
      "name": "Ars Magna Elfnote",
      "effect": "2 monsters, including an \"Ars Magna\" or \"Elfnote\" monster\nYour linked monsters gain 300 ATK for each different Monster Type on the field. You can only use each of the following effects of \"Ars Magna Elfnote\" once per turn. During your Main Phase: You can send to the GY, or banish, 1 card you control, then you can return 1 monster on the field to the hand. You can banish this card from your GY; Special Summon 1 \"Elfnote\" monster from your hand.",
      "official": false
    },
    "ja": {
      "name": "\u7121\u57a2\u306a\u308b\u5354\u594f \u30a8\u30eb\u30d5\u30a7\u30f3\u30ce\u30fc\u30c4",
