  "text": {
    "en": {
      "name": "Ultimate Sky",
      "effect": "If your opponent controls more monsters than you do: Activate 1 of these effects (but you can only use each effect of \"Ultimate Sky\" once per turn);\n\u25cf Target face-up cards on the field up to the number of face-up monsters your opponent controls and pay 800 LP for each target; negate their effects until the end of this turn.\n\u25cf When your opponent activates a monster effect in the hand or GY: Negate that effect.",
      "official": false
    },
