  "text": {
    "en": {
      "name": "Amazoness Swords Woman",
      "effect": "Your opponent takes any battle damage you would have taken from battles involving this card instead."
    },
    "fr": {
      "name": "\u00c9p\u00e9e Amazonesse",
      "effect": "Votre adversaire re\u00e7oit les dommages de combat que vous auriez d\u00fb recevoir de combats impliquant cette carte \u00e0 la place."
    },
    "de": {
      "name": "Amazonische Schwertk\u00e4mpferin",
      "effect": "Dein Gegner erh\u00e4lt statt dir den Kampfschaden, den du aus K\u00e4mpfen, an denen diese Karte beteiligt ist, erhalten h\u00e4ttest."
    },
    "it": {
      "name": "Spadaccina Amazoness",
      "effect": "Il tuo avversario subisce qualsiasi danno da combattimento che subiresti tu nelle battaglie che coinvolgono questa carta al tuo posto."
    },
    "pt": {
      "name": "Espada Amazoness",
      "effect": "Seu oponente sofre qualquer dano de batalha que voc\u00ea teria sofrido das batalhas envolvendo este card, em vez de voc\u00ea."
    },
    "es": {
      "name": "Espadachina Amazoness",
      "effect": "Tu adversario recibe cualquier da\u00f1o de batalla que fueras a recibir t\u00fa de batallas que involucren esta carta."
    },
