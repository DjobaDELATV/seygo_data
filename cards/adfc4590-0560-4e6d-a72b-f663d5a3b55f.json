  "text": {
    "en": {
      "name": "Swift Birdman Joe",
      "effect": "If you Tribute Summon this card by Tributing a WIND monster, return all Spell and Trap Cards on the field to the owners' hands."
    },
    "fr": {
      "name": "Jo, l'Homme-Oiseau Prompt",
      "effect": "Si vous faites l'Invocation Sacrifice de cette carte en sacrifiant un monstre VENT, renvoyez toutes les Cartes Magie et Pi\u00e8ge sur le Terrain dans la main de leur propri\u00e9taire."
    },
    "de": {
      "name": "Schneller Vogelmann Joe",
      "effect": "Falls du f\u00fcr die Tributbeschw\u00f6rung dieses Monsters ein WIND Monster als Tribut angeboten hast, gib alle Zauber- und Fallenkarten auf dem Spielfeld auf die H\u00e4nde ihrer Besitzer zur\u00fcck."
    },
    "it": {
      "name": "Joe Veloce Uomo Alato",
      "effect": "Se Evochi tramite Tributo questa carta offrendo come Tributo un mostro VENTO, fai ritornare tutte le Carte Magia e Trappola sul Terreno in mano ai rispettivi proprietari."
    },
    "es": {
      "name": "Swift Birdman Joe",
      "effect": "Si Invocas esta carta mediante una Invocaci\u00f3n de Sacrificio Sacrificando un monstruo de VIENTO, devuelve a las manos de sus propietarios todas las Cartas M\u00e1gicas y de Trampa en el Campo."
    },
    "ja": {
