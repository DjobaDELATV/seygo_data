  "text": {
    "en": {
      "name": "Finger Game",
      "effect": "Each player places 2 cards from their Deck on top of their Deck in any order, then they declare a number from 0 to 4, then they excavate the top 2 cards of their Deck. The player(s) whose declared number is the same as the number of monsters among all 4 excavated cards adds 1 of their excavated cards to their hand, also they place the other on the bottom of their Deck. The player(s) whose declared number is not the same places their excavated cards on the bottom of their Deck in any order. You can only activate 1 \"Finger Game\" per turn.",
      "official": false
    },
    "ja": {
