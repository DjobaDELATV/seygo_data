      "effect": "\u3053\u306e\u30ab\u30fc\u30c9\u304c\u53ec\u559a\u306b\u6210\u529f\u3057\u305f\u6642\u3001\u81ea\u5206\u306e\u624b\u672d\u3092\u4efb\u610f\u306e\u679a\u6570\u5893\u5730\u306b\u9001\u308b\u4e8b\u3067\u3001\u305d\u306e\u679a\u6570\u5206\u3060\u3051\u30d5\u30a3\u30fc\u30eb\u30c9\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u6301\u3061\u4e3b\u306e\u624b\u672d\u306b\u623b\u3059\u3002"
    },
