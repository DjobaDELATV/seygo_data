  "text": {
    "en": {
      "name": "Ojama King",
      "effect": "\"Ojama Green\" + \"Ojama Yellow\" + \"Ojama Black\"\nChoose up to 3 of your opponent's unused Monster Zones. Those zones cannot be used."
    },
    "fr": {
      "name": "Ojama Roi",
      "effect": "\"Ojama Vert\" + \"Ojama Jaune\" + \"Ojama Noir\"\nChoisissez max. 3 Zones Monstre inutilis\u00e9es de votre adversaire. Ces zones ne peuvent pas \u00eatre utilis\u00e9es."
    },
    "de": {
      "name": "Ojama-K\u00f6nig",
      "effect": "\u201eGr\u00fcner Ojama\u201c + \u201eGelber Ojama\u201c + \u201eSchwarzer Ojama\u201c\nBestimme bis zu 3 der nicht verwendeten Monsterzonen deines Gegners. Die Zonen k\u00f6nnen nicht verwendet werden."
    },
    "it": {
      "name": "Re Ojama",
      "effect": "\"Ojama Verde\" + \"Ojama Giallo\" + \"Ojama Nero\"\nSeleziona fino a 3 Zone Mostri inutilizzate del tuo avversario. Quelle zone non possono essere utilizzate."
    },
    "pt": {
      "name": "Rei Ojama",
      "effect": "\"Ojama Verde\" + \"Ojama Amarelo\" + \"Ojama Negro\"\nSelecione at\u00e9 3 das Zonas de Monstros n\u00e3o utilizadas do seu oponente. Essas zonas n\u00e3o podem ser usadas."
    },
    "es": {
      "name": "Rey Ojama",
      "effect": "\"Ojama Verde\" + \"Ojama Amarillo\" + \"Ojama Negro\"\nElige hasta 3 Zonas de Monstruos de tu adversario sin usar. Esas zonas no pueden ser usadas."
    },
    "ja": {
      "name": "\u304a\u30b8\u30e3\u30de\u30fb\u30ad\u30f3\u30b0",
      "effect": "\u300c\u304a\u30b8\u30e3\u30de\u30fb\u30b0\u30ea\u30fc\u30f3\u300d\uff0b\u300c\u304a\u30b8\u30e3\u30de\u30fb\u30a4\u30a8\u30ed\u30fc\u300d\uff0b\u300c\u304a\u30b8\u30e3\u30de\u30fb\u30d6\u30e9\u30c3\u30af\u300d\n\u3053\u306e\u30ab\u30fc\u30c9\u304c\u30d5\u30a3\u30fc\u30eb\u30c9\u4e0a\u306b\u8868\u5074\u8868\u793a\u3067\u5b58\u5728\u3059\u308b\u9650\u308a\u3001\u76f8\u624b\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u30ab\u30fc\u30c9\u30be\u30fc\u30f3\u3092\uff13\u30ab\u6240\u307e\u3067\u4f7f\u7528\u4e0d\u53ef\u80fd\u306b\u3059\u308b\u3002"
    },
    "ko": {
      "name": "\ubc29\ud574\uafbc \ud0b9",
      "effect": "\"\ubc29\ud574\uafbc \uadf8\ub9b0\" + \"\ubc29\ud574\uafbc \uc610\ub85c\" + \"\ubc29\ud574\uafbc \ube14\ub799\"\n\uc774 \uce74\ub4dc\uac00 \ud544\ub4dc \uc704\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \uc874\uc7ac\ud558\ub294 \ud55c, \uc0c1\ub300\uc758 \ubaac\uc2a4\ud130 \uce74\ub4dc \uc874\uc744 3\uac1c\uae4c\uc9c0 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uac8c \ud55c\ub2e4."
    }
