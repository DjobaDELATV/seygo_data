  "text": {
    "en": {
      "name": "Makyura, Destructor of the Sun God",
      "effect": "If this card is Normal or Special Summoned, or sent from the hand or field to the GY: You can Set 1 \"Sun God\" Spell/Trap from your hand or Deck, and if you Set a Trap or Quick-Play Spell, it can be activated this turn. During the End Phase, if \"The Immortal Sun God\" was sent to your GY this turn: You can add this card from your GY to your hand. You can only use each effect of \"Makyura, Destructor of the Sun God\" once per turn.",
      "official": false
    },
